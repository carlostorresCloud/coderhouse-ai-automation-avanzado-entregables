      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const data = item.json.output || {};\n\n  const correoRaw = (data.correo || '').toString().trim();\n  const asunto = (data.asunto || '').toString().trim();\n\n  // Extraer el email \n  const match = correoRaw.match(/<([^>]+)>/);\n  const correo = (match ? match[1] : correoRaw).trim().toLowerCase();\n\n  // Validar que el correo tenga un formato correcto\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  const errores = [];\n  if (!correo) errores.push('El correo está vacío');\n  else if (!emailRegex.test(correo)) errores.push('El correo no tiene un formato válido');\n  if (!asunto) errores.push('El asunto está vacío');\n\n  results.push({\n    json: {\n      ...item.json,\n      output: {\n        ...data,\n        correo,   // correo ya limpio\n        asunto,\n      },\n      isValid: errores.length === 0,\n      errores,\n    },\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
